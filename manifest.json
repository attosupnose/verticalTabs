{
  "manifest_version": 3,
  "name": "Vertical Tabs: compact, float",
  "version": "1.0.2",
  "description": "Vertical Tabs: compact, float - Manage all your browser tabs in a vertical panel",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ]
}
