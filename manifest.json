{
  "manifest_version": 3,
  "name": "Все вкладки",
  "version": "1.0.0",
  "description": "Расширение для просмотра и управления всеми открытыми вкладками",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons-tab-manager.png",
      "48": "assets/icons-tab-manager.png",
      "128": "assets/icons-tab-manager.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons-tab-manager.png",
    "48": "assets/icons-tab-manager.png",
    "128": "assets/icons-tab-manager.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
